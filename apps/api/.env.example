NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# SnailPay simulation
# Set to true to simulate an internal SnailPay outage (503, nothing is approved).
# It can also be triggered per request with the header: x-snailpay-simulate: system_error
SNAILPAY_DOWN=false
# Delay before answering the "timeout" test card (4222 2222 2222 2222), in ms.
SNAILPAY_TIMEOUT_MS=10000
